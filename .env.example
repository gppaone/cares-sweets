# Copy to .env and fill in. Never commit the real .env file.

# --- Required for Docker Compose ---
# Use letters and numbers only (it is placed inside a connection URL).
POSTGRES_PASSWORD=change-me-db-password

# Password for the /admin editor.
ADMIN_PASSWORD=change-me-admin-password

# Long random string used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-long-random-string

# The exact address people type to reach the site, with no trailing slash.
# Needed so form posts (admin + contact) are accepted. Examples:
#   http://192.168.1.50:3000
#   https://trucks.example.com
ORIGIN=http://localhost:3000

# --- Optional ---
# Set to true only when the site is served over HTTPS (e.g. via a reverse proxy).
COOKIE_SECURE=false
# Host port to publish the site on.
PORT=3000
TZ=America/New_York

# --- Only for local development with `npm run dev` ---
# DATABASE_URL=postgres://cares:cares@localhost:5432/cares
